+int Synthesizer::renderAudioSynchronous(int16_t *target, int capacity) {
+    if (m_thread != nullptr || m_inputChannelCount <= 0 || capacity < 0 || (capacity > 0 && target == nullptr)) {
+        throw std::logic_error("Invalid synchronous Synthesizer use");
+    }
+    const int n = std::min(capacity, int(m_inputChannels[0].data.size()));
+    for (int i = 0; i < m_inputChannelCount; ++i) {
+        m_inputChannels[i].data.readAndRemove(n, m_inputChannels[i].transferBuffer);
+        m_filters[i].airNoiseLowPass.setCutoffFrequency(
+            m_audioParameters.airNoiseFrequencyCutoff, m_audioSampleRate);
+        m_filters[i].jitterFilter.setJitterScale(m_audioParameters.inputSampleNoise);
+    }
+    for (int i = 0; i < n; ++i) target[i] = renderAudio(i);
+    return n;
+}
